#!/usr/bin/env bash

set -euo pipefail

if ! command -v aws &> /dev/null; then
  echo "aws CLI not found. Install it and try again."
  exit 1
fi

SECRET=$(aws secretsmanager get-secret-value --secret-id startline/docs --query SecretString --output text 2>/dev/null || echo "")

if [ -z "$SECRET" ]; then
  echo "Secret startline/docs not found in AWS Secrets Manager."
  echo "Run setup.sh first to create it."
  exit 1
fi

echo "$SECRET" | jq -r 'to_entries[] | "export \(.key)=\(.value)"' | while read -r line; do
  eval "$line"
done
