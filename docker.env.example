NODE_ENV=production

URL=https://docs.startlineau.com
PORT=3000
FORCE_HTTPS=true
WEB_CONCURRENCY=1

SECRET_KEY=change_me
UTILS_SECRET=change_me

DATABASE_URL=postgres://outline:outline@postgres:5432/outline
PGSSLMODE=disable
DATABASE_CONNECTION_POOL_MIN=0
DATABASE_CONNECTION_POOL_MAX=5

REDIS_URL=redis://redis:6379

FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

OIDC_CLIENT_ID=change_me
OIDC_CLIENT_SECRET=change_me
OIDC_AUTH_URI=change_me
OIDC_TOKEN_URI=change_me
OIDC_USERINFO_URI=change_me
OIDC_LOGOUT_URI=change_me
OIDC_DISPLAY_NAME=Startline
OIDC_USERNAME_CLAIM=email
OIDC_SCOPES=openid profile email

SMTP_HOST=change_me
SMTP_PORT=587
SMTP_USERNAME=change_me
SMTP_PASSWORD=change_me
SMTP_FROM_EMAIL=docs@startlineau.com
SMTP_FROM_NAME=Startline Docs
SMTP_SECURE=false

RATE_LIMITER_ENABLED=true
RATE_LIMITER_REQUESTS=1000
RATE_LIMITER_DURATION_WINDOW=60
